# ============================================================================
# [W1] WARM-UP REQUIREMENT: Example test database environment configuration
# Copy to .env.test before running tests
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=12345
DB_NAME=assignment2_test
PORT=3001

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# JWT Secrets for Test Environment
JWT_SECRET=super-secret-jwt-key-assignment1-week10-test-cmit
JWT_ACCESS_EXPIRATION_TIME=15m
JWT_REFRESH_EXPIRATION_TIME=7d

# Argon2 Cost Settings
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1

# Throttler configuration
THROTTLE_TTL=60000
THROTTLE_LIMIT=1000
THROTTLE_AUTH_LIMIT=1000

# Node Environment
NODE_ENV=test
