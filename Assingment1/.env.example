DB_PASSWORD=12345
DB_NAME=assignment3
PORT=3000

# [W2] Allowed CORS Origin
FRONTEND_URL=http://localhost:3000

# [C2] JWT Secret and Expiration configurations
JWT_SECRET=super-secret-jwt-key-assignment3-week9-security-hardening-cmit
